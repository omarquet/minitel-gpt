#pragma once
// Copier ce fichier en secrets.h (dans le meme dossier) et remplir les valeurs.
// secrets.h est ignore par git : il ne doit JAMAIS etre commite.

#define WIFI_SSID      "TON_SSID"
#define WIFI_PASSWORD  "TON_MDP_WIFI"

// Reseaux de secours, FACULTATIFS : essayes dans l'ordre si le premier ne
// repond pas. Le partage de connexion d'un telephone a sa place ici - c'est
// le reseau qu'on a toujours sur soi quand on emmene le Minitel quelque part.
// Laisser ces lignes commentees si on n'en veut pas : le firmware s'adapte.
// #define WIFI_SSID2     "PARTAGE_DE_CONNEXION"
// #define WIFI_PASSWORD2 "MDP_DU_PARTAGE"
// #define WIFI_SSID3     "AUTRE_RESEAU"
// #define WIFI_PASSWORD3 "MDP_AUTRE_RESEAU"

// Serveur a joindre. Ce n'est pas un secret, mais c'est propre a TON
// installation : dans firmware.ino, ce serait versionner un nom de domaine et
// l'IP locale d'une machine, et modifier du code suivi par git pour un test.
// USE_LOCAL choisit la paire utilisee ET le transport (ws:// ou wss://).
#define USE_LOCAL      0
#define WS_HOST_PROD   "minitel.exemple.fr"
#define WS_PORT_PROD   443
// A remplir pour tester en local (USE_LOCAL 1) :
// #define WS_HOST_LOCAL  "192.168.1.10"    // ipconfig getifaddr en0
// #define WS_PORT_LOCAL  8080

// WS_TOKEN du serveur (variable d'environnement cote Coolify), URL-ENCODE :
//   @ -> %40    = -> %3D    : -> %3A    / -> %2F    + -> %2B    espace -> %20
// La lib WebSockets envoie le chemin tel quel, sans encoder quoi que ce soit.
#define WS_TOKEN_ENC   "TON_TOKEN_URLENCODE"
